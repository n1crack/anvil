{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anvil",
  "identifier": "dev.anvil.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Anvil",
        "width": 1140,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQjI4QUVGMzgzNUMwM0UKUldRK3dEVTQ3NHF5Z0owU20rQmRDeU5xSTZoamtYNHMrSVMwbEdGa3JuUWNlMGI3Qk56R0JjYlYK",
      "endpoints": ["https://github.com/n1crack/anvil/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
