{
  "mainBinaryName": "anvil-app",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anvil",
        "width": 1140,
        "height": 700,
        "minWidth": 760,
        "minHeight": 480,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
